PORT = xxxxx

GEMINI_API_KEY=xxxxx

GOOGLE_APPLICATION_CREDENTIALS=xxxxxxxx

GOOGLE_SHEET_ID=xxxxxxxx


# ---------------- Discovery pipeline (optional; sensible defaults) ----------------
# MongoDB for jobs, discovered companies, scores, top 10 and winner.
# Without it an in-memory store is used (development only, not persisted).
MONGODB_URI=

# Gemini (same key as above). Model overrides:
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FINAL_MODEL=
GEMINI_SEARCH_GROUNDING=true
AI_CONCURRENCY=3

# Optional official search APIs (more discovery coverage + website resolution)
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Discovery limits (safety caps, not targets - discovery stops on saturation)
DISCOVERY_DEFAULT_MAX_CANDIDATES=500
DISCOVERY_HARD_MAX_CANDIDATES=5000
DISCOVERY_MAX_ROUNDS=6
DISCOVERY_QUERIES_PER_ROUND=12
MIN_QUALIFIED_SCORE=40

# Crawler etiquette
CRAWLER_USER_AGENT=AgencyLeadDiscoveryBot/1.0 (+https://your-domain.com/bot)
CRAWLER_ROBOTS_TOKEN=AgencyLeadDiscoveryBot
CRAWLER_CONCURRENCY=8
CRAWLER_PER_HOST_INTERVAL_MS=1500
CONTACT_EMAIL_POLICY=role_based

# Background worker
JOB_CONCURRENCY=2
DISCOVERY_WORKER_ENABLED=true
LOG_LEVEL=info
